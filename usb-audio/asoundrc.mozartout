# 变声音频与译文播报共用一个输出设备。
# 安装：复制到 ~/.asoundrc，或把内容追加到已有的 ~/.asoundrc。
# 之后把 PLAYBACK 设为 mozartout，例如
#   PLAYBACK=mozartout SPEECH=1 tools/run-realtime-voice.sh start
pcm.mozartout {
    type plug
    slave {
        pcm "dmix:CARD=Device,DEV=0"
        rate 48000
        channels 2
        format S16_LE
    }
}
