[Unit]
Description=Mozart USB 音频桥（FunctionFS bulk ↔ snd-aloop）
After=sound.target
Wants=sound.target

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/mozart-gadget-setup.sh
Environment=MOZART_MIC=plughw:CARD=Loopback,DEV=1,SUBDEV=1
Environment=MOZART_SPEAKER=plughw:CARD=Loopback,DEV=0,SUBDEV=0
Environment=MOZART_UDC=3550000.usb
ExecStart=/home/moyamryia/Mozart/.venv/bin/python3 /home/moyamryia/aec-study-20261020/jetson-daemon.py
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
