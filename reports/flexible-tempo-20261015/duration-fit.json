  "calibration_rows": [
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:1",
      "job": "3d8d649be10c42dfb11641051cc0ce53",
      "text": "Mama said that during the summer vacation,",
      "seconds": 2.64,
      "sha256": "026ec3e9c7251994c9c9b9a0abb8e14235d72ab7fbafaad2995dd2586357e241"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:1",
      "job": "3d8d649be10c42dfb11641051cc0ce53",
      "text": "she took a course to help boost the result of the exam",
      "seconds": 3.12,
      "sha256": "297afb2c488f7151ba46f7e0c2bdfdc45de0dcaf726d8cb7afa29b30e88f089b"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:1",
      "job": "3d8d649be10c42dfb11641051cc0ce53",
      "text": "and won a large sum of money.",
      "seconds": 1.84,
      "sha256": "e3a3564d534980610cefdda060e1a431bb71a62a00fdd224d24f3b594dda6401"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:1",
      "job": "922d9556a2e2441c9e5a6d290f52aacc",
      "text": "You paid with this exam to your mom a lot of gold coins?",
      "seconds": 3.6,
      "sha256": "b4f71e1512a6cfe8ec27043aac4934a484181a8291b6adb3b1a45477317764df"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:2",
      "job": "8ff9fd6cd8864bfe9736e7db9c126734",
      "text": "Seven thousand five thousand is a large number.",
      "seconds": 2.64,
      "sha256": "02b2be0f39f852dbe145c9a17ab8ca4245d2a859c72127eaa142df1758896623"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:3",
      "job": "71d4321a6f9a4701bb3553d223e767f5",
      "text": "Your mother is thinking about the house.",
      "seconds": 2.16,
      "sha256": "ec46be99be62079e47a5dca6da76a3e174082f62887985cec17c3884541d9c0e"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:4",
      "job": "f433b8c217a74795bf2f421eecc85c77",
      "text": "My son is studying for a graduate exam at school.",
      "seconds": 3.2,
      "sha256": "9a4c23cebbce145ed40a533c374aca5270f0eb939d7c36576405e8972b73b7a5"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:5",
      "job": "dba33d1261de478fa665482ae69bfa62",
      "text": "Your mother is dancing with the lobster older woman in the square dance.",
      "seconds": 4.16,
      "sha256": "5a9978f08882e5fb80429eae6e325aebb75423ecbee349564dc902a57aa4c1fd"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:5",
      "job": "b5a6e0b2767b43c7b3191a35c8793689",
      "text": "Or when the daughter is quiet, the son will be more.",
      "seconds": 2.72,
      "sha256": "a3e8930a24f4b1e17f455a0242c9d49b6390b21d388547f6f21d46131c8601a6"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:5",
      "job": "20b2c4d97bb14709aff954c7b957bc4c",
      "text": "Now how is it that your mother is proud to tell the people",
      "seconds": 3.36,
      "sha256": "522630d4458b56e16d25a2007ac2b92c514dac2552ba694a939bdc26a435310d"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:6",
      "job": "d0a835ae190d433483ec07e2a35daf8c",
      "text": "My son",
      "seconds": 1.2,
      "sha256": "16265647ac0691fc30c0acee910aa12631ad2685018c753aeb279dc22bdc8711"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:7",
      "job": "3c7b43563b3543a095cb724847fb5806",
      "text": "Now preparing for the graduate entrance exam.",
      "seconds": 3.44,
      "sha256": "7a0754349df000849cfdc8d1414bb69eded4e974cb069223f836a3d2255597a6"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:7",
      "job": "2369808be285498885bde4fd79b2751d",
      "text": "You speak slowly, and your heart still feels a little bit happy",
      "seconds": 3.44,
      "sha256": "c21c7709883a3477bcc038a18dd04a2ae17062cafeeba2567016f85d9a134b8b"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:7",
      "job": "2369808be285498885bde4fd79b2751d",
      "text": "that your son is there.",
      "seconds": 1.76,
      "sha256": "9bd0bb0aaa99431ce9bbd938a1f94f7788d9a46599de78015a3c469f9cc96591"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:8",
      "job": "c02cb402bf3647cc92bce1a9678f7aa1",
      "text": "I am working.",
      "seconds": 1.04,
      "sha256": "8cda50dc4cb19266e0e1e441cdb116850a08e9c2b87825a93e49ad2c1240db7e"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:8",
      "job": "7e675794d4aa4b72aa70e7af9cc36d43",
      "text": "You are gambling and you are asking me to borrow a loan.",
      "seconds": 3.28,
      "sha256": "ea987187e7dc2eb7c3f00412e80f534f74832466df11d77f4e9954d91ebe0b5f"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:8",
      "job": "a37f6fecd198422fb61ebe5c80e4b70c",
      "text": "You are in a web dating situation where everyone is using this to borrow money.",
      "seconds": 4.16,
      "sha256": "94292fc52708485dacc14852ca980beec55f9cf47f50550ca03dcf3637d63a74"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:8",
      "job": "2e194466450e4edfa3fff5cb1425c194",
      "text": "No one has anything to brag about.",
      "seconds": 1.92,
      "sha256": "e32509646512c2c0fcabed0a0360caf2c7bdec4840d7be53165de3e2e30494cf"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:9",
      "job": "435d1f9cef104ac2bb5fb78a2d0abd66",
      "text": "That is you.",
      "seconds": 1.12,
      "sha256": "f62adfd138163b728471312173a2b1be4c70208e3e6643827710ded83e1a6714"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:10",
      "job": "0c42715eee2e4baaa22848bc5f6f0d06",
      "text": "Repay the loan",
      "seconds": 1.36,
      "sha256": "c02549b85d027f8852318871ee7d43be578fcc278412f39932e5ff1bd4bf5764"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:11",
      "job": "52542acff66f4c5c8e8260967849f954",
      "text": "Soon, the land will be returned to the original owner.",
      "seconds": 3.36,
      "sha256": "bb04fd93a36567a0e6b0000b40aa84259cb6cdba7766091ce2d4c93ece113c8f"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:11",
      "job": "019b9e2ca0584902ace5db48d1399cb7",
      "text": "This is the classic process of scamming or borrowing money.",
      "seconds": 3.28,
      "sha256": "6f3509687f662049de272f0c3e4de20cbc78c385e2c0e00c793418d8f273a464"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:12",
      "job": "b519462adbca4a309efb5141c2ff27eb",
      "text": "Then recharge.",
      "seconds": 1.12,
      "sha256": "4dfd378e4368b36fc1dad11a343cdec3d46c4e6d454639c576a0769462b88fa1"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:13",
      "job": "67fa846bdc144684a7c1d7f2a74d1c83",
      "text": "Just the subsidy plan may win for a while.",
      "seconds": 2.4,
      "sha256": "ec848bd6fcc14df4b0fe0982d47c3612c8c081d49ca8a13e0aaa0d6486c11d41"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:14",
      "job": "eab34afe7ffe4cc8a83cabebf2420531",
      "text": "It will come down to one day when the top",
      "seconds": 2.08,
      "sha256": "082d6c443acd9a297602fb249177db9c556e6f8b0b70c09aeff8abf53a808daa"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:14",
      "job": "eab34afe7ffe4cc8a83cabebf2420531",
      "text": "and the top will not be able to lose everything.",
      "seconds": 2.4,
      "sha256": "d235c93689b587152f2cb0e232470f697d23260c566e4bec7db2bf62feffdbb8"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:14",
      "job": "21aebc844edc4b9d91a2b73f7b03018a",
      "text": "After that, they start borrowing money or deceiving it.",
      "seconds": 3.36,
      "sha256": "a7484f35a29857123cb29aaf1e12350e6932dcdb0581c4c2f3d4149ba591258c"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:14",
      "job": "1bd0553e14404e8fad9a3afcef86532f",
      "text": "And then he entered again and then the subsidy plan.",
      "seconds": 3.44,
      "sha256": "f5d15529ab413185ff0e23d957209c56f8445f415124bfd2cf016b458356fc55"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:15",
      "job": "c56edcf9af9948e6b59bd2c62d98d5da",
      "text": "Then maybe they will win or lose it all,",
      "seconds": 2.32,
      "sha256": "5934b42000e21f55f77812f3528939bd18d08d8e04919abe85e41cd3f7d3fcdc"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:15",
      "job": "c56edcf9af9948e6b59bd2c62d98d5da",
      "text": "but the result is the end result.",
      "seconds": 2.0,
      "sha256": "20ad2e209a78ff11110cc552ec4ee7cad01d85021d7727c7910d813bb498aa34"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:15",
      "job": "22ba7b97271e4b9eacb32af6a57203ab",
      "text": "It will definitely lose, for this is the loop.",
      "seconds": 2.64,
      "sha256": "11fa126072f8f4cefbf2ece5cbbdbf3b3b01a8276fcbf8cb0c905bad53959eb4"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:15",
      "job": "0946b350d4b240f093aed1759a21bcfc",
      "text": "This is reading dogs.",
      "seconds": 1.6,
      "sha256": "a89bdd3c8d5b689f5113fbc4cef9142e3f3260af64b0de32f29a5bee9222f372"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:15",
      "job": "87bc0ba1815b40fa8390979a2b2b44a2",
      "text": "No escape from the loop; no single dog can escape.",
      "seconds": 4.24,
      "sha256": "0359f47b5639fcdde39e6e931bd1433cfbbf22b713e0522fd1a18be24b996304"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:16",
      "job": "33050f40bfb54948b5123bfc3eedb8dd",
      "text": "For example, to enroll in a political class or a small class,",
      "seconds": 4.8,
      "sha256": "58cf95a6eea5dc5e85a69f38597e214ac81d813d18345f284325692f6f18e2a7"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:16",
      "job": "33050f40bfb54948b5123bfc3eedb8dd",
      "text": "you need to pay 10000 yuan.",
      "seconds": 2.0,
      "sha256": "7768ef59c282a641eafa6dc56147890068cf8940f0ea4c2b831287f596936c86"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:16",
      "job": "60dda389ad7e473c89e24fa126ce74eb",
      "text": "Okay because you're holding on to your learning",
      "seconds": 2.4,
      "sha256": "b47735466962c43090d02a87b600b2f9a7db9f8693e8a8eccd892f5efffbd271"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:17",
      "job": "9abd214d032e4ea8a02abec384abe024",
      "text": "To run a research project, a political student must have a class.",
      "seconds": 4.08,
      "sha256": "542e6d03df6abc41f877fb23fdb9668708740602fc8632016794992710aff7ae"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:17",
      "job": "05bfc8dcbdf74fff94a6ddad9bda90dc",
      "text": "You are going to deceive your mother with money.",
      "seconds": 2.64,
      "sha256": "53e72632a08d5dfbd83762236df55c62880067dd049c4b3a2d6e44c2d4e0ee7d"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:18",
      "job": "7ffbab238b6543fab73a152bf428f0ab",
      "text": "Do you read this and find out if it's a lie?",
      "seconds": 1.92,
      "sha256": "d35422a462a221643a61a6062dd968cff53c8e1e6453372339df82f6f35276f0"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:18",
      "job": "102c4f45409744dabf7c7e5845defc96",
      "text": "You can't tell a lie with money.",
      "seconds": 2.0,
      "sha256": "f5d2afade8c7b5fe30303573b98588087723020299259fac4f03581c83431822"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:18",
      "job": "f61d53fe7fd7490a9bfdafab436d344d",
      "text": "As long as you can get money.",
      "seconds": 1.84,
      "sha256": "efc125aac576ce14ba2365182f7735879d3183d97b79e98a937007ddc9f8122d"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:18",
      "job": "2821989c3bd94f249917e8cb8fa0cf04",
      "text": "He ignores whoever is facing him and ignores himself.",
      "seconds": 2.72,
      "sha256": "d3e6c323b9bda1c49f3ec609a136c9812d5ecfb63e51fe7798af6fa8423d9565"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:19",
      "job": "8787414fc2bb41d48ab729cd61fd32ae",
      "text": "To earn money, to get money, to recover",
      "seconds": 2.96,
      "sha256": "208e122641cf8bf31573d13b7ff89a24787eaa21f767d1d53181214d1f567168"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:20",
      "job": "b672b6eca5b0487c9ff8a6f581ba2e53",
      "text": "Qian wins back all the lies.",
      "seconds": 1.84,
      "sha256": "d1c576bd4e3fa3ee56cf838d20def13782780f1316f9d19467f5e19ec469e3bf"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:21",
      "job": "c43ba9a577384bfcb8b7b51983aef0fd",
      "text": "can not be treated as a threat",
      "seconds": 2.0,
      "sha256": "23894688d7687de7d8a9c9172edbb02d07da487a74a5b8b07fc8e2de0ada62aa"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:22",
      "job": "f0bfb66b22464f8aadb38f04feacf16c",
      "text": "At this point, the mother has become increasingly doubtful.",
      "seconds": 3.76,
      "sha256": "07e22418efbb9aec42d01c580d6fe581a9250752d0b2eda24d6cce3da25f58d1"
    },
    {
      "parent": "bbc6cbcf512c4281b0a3c17e667867a7:23",
      "job": "1a8043a6b09e4dbeb532cee5f1b979e4",
      "text": "Mother still doubted me because of me.",
      "seconds": 2.4,
      "sha256": "5a8623ff3b3deee0436743d0d23594b38e5068192964f2013fa32434858d9185"
    }
  ],
