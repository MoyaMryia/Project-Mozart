[Unit]
Description=Mozart 控制台静态服务
After=network.target

[Service]
Type=simple
User=moyamryia
Group=moyamryia
WorkingDirectory=/home/moyamryia/Projects/Project-Mozart
ExecStart=/usr/bin/python3 tools/serve-console.py --host 0.0.0.0 --port 8080 --api 127.0.0.1:18080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
